{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFrame Console",
  "version": "0.1.0",
  "identifier": "com.openframe.console",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' https://www.googletagmanager.com https://us-assets.i.posthog.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "frame-src": "'self' https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' https://www.googletagmanager.com https://us-assets.i.posthog.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://localhost:* http://127.0.0.1:*",
        "font-src": "'self' data:",
        "media-src": "'self' blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*",
        "frame-src": "'self' https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRjgwQjhFQzM4NDA2N0EKUldSNkJvVERqZ3Y0WWU0S1IrOTljT0d5Q0pKU0NaUHNBODdvR3preEVkK0lYRVJPNkgxSXdTYysK",
      "endpoints": [
        "https://updates.openframe.invalid/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Flamingo AI, Inc.",
    "copyright": "Copyright © 2026 Flamingo AI, Inc.",
    "homepage": "https://openframe.ai/",
    "createUpdaterArtifacts": true,
    "licenseFile": "installer/LICENSE.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}

