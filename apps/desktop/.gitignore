# Dependencies / build output
/node_modules
/src-tauri/target
/src-tauri/gen/schemas
# Written by tauri-build from the command list in build.rs
/src-tauri/permissions/autogenerated

# Staged frontend bundle — produced by scripts/build-web.sh, never committed
/www

# Local config and secrets. tokens.json / config.json live in the OS app-config
# dir, not in the repo, but keep the patterns so a stray copy can't be committed.
.env
.env.*
!.env.example
tokens.json
config.json
*.pem
*.p12
*.key
*.keystore
*.jks

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db
