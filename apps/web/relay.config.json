{
  "sources": {
    "src": "api",
    "src/app/(app)/mingo/models": "chat"
  },
  "excludes": ["**/node_modules/**", "**/__mocks__/**", "**/__generated__/**"],
  "projects": {
    "api": {
      "language": "typescript",
      "eagerEsModules": true,
      "customScalarTypes": {
        "Instant": {
          "name": "Instant",
          "path": "../lib/graphql-scalars"
        },
        "Date": {
          "name": "LocalDate",
          "path": "../lib/graphql-scalars"
        },
        "Long": {
          "name": "Long",
          "path": "../lib/graphql-scalars"
        },
        "JSON": {
          "name": "JsonValue",
          "path": "../lib/graphql-scalars"
        },
        "ObjectId": "string",
        "_FieldSet": "string"
      },
      "requireCustomScalarTypes": true,
      "useImportTypeSyntax": true,
      "output": "src/__generated__",
      "schema": "schema.graphql"
    },
    "chat": {
      "language": "typescript",
      "eagerEsModules": true,
      "customScalarTypes": {
        "Instant": {
          "name": "Instant",
          "path": "../../lib/graphql-scalars"
        },
        "Date": {
          "name": "LocalDate",
          "path": "../../lib/graphql-scalars"
        },
        "Long": {
          "name": "Long",
          "path": "../../lib/graphql-scalars"
        },
        "JSON": {
          "name": "JsonValue",
          "path": "../../lib/graphql-scalars"
        },
        "ObjectId": "string",
        "_FieldSet": "string"
      },
      "requireCustomScalarTypes": true,
      "useImportTypeSyntax": true,
      "output": "src/chat/__generated__",
      "schema": "schema.chat.graphql"
    }
  }
}
