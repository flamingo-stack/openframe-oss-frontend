# deps
node_modules/

# web bundle (build artifact — produced by build:web / web:placeholder)
www/

# native build output (lane archives, exported .ipas, DerivedData)
build/
# defensive: the same artifacts if a lane is ever pointed outside build/
*.xcarchive/
*.ipa
*.dSYM/

# macOS / editors
.DS_Store
*.log

# iOS internals are handled by ios/.gitignore (Capacitor-generated):
# App/build, App/App/public, DerivedData, xcuserdata, generated config, etc.

# machine-specific absolute symlinks into node_modules, regenerated by cap sync
ios/App/CapApp-SPM/symlinks/

# Firebase config drop zone (source exports staged here before being copied
# into the platform dirs; per-env configs are supplied out-of-band, never committed)
firebase/

# secrets / signing keys — must NEVER be committed (defensive, repo-wide).
# android/.gitignore also covers *.jks/*.keystore/keystore.properties under android/.
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.cer
*.jks
*.keystore
keystore.properties
signing.properties

# editors / IDEs
.idea/
.vscode/

