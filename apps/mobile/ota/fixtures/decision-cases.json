{
  "cases": [
    {
      "name": "a release above the built-in one is downloaded",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "download"
    },
    {
      "name": "the built-in release itself: drop every OTA bundle",
      "shell": { "builtinVersion": "1.2.3", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.5", "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "drop"
    },
    {
      "name": "a release below the built-in one (the kill pin): drop every OTA bundle",
      "shell": { "builtinVersion": "1.3.0", "bridgeLevel": 2 },
      "bundles": { "active": "1.3.4", "pending": "1.3.5", "bad": [] },
      "payload": { "version": "1.2.9", "bridgeLevel": 1 },
      "expect": "drop"
    },
    {
      "name": "the active bundle's release: nothing",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.3", "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "nothing"
    },
    {
      "name": "the pending bundle's release: nothing",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.2", "pending": "1.2.3", "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "nothing"
    },
    {
      "name": "a release marked bad: nothing",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.2", "pending": null, "bad": ["1.2.3"] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "nothing"
    },
    {
      "name": "a release below the active bundle but above the built-in one (a rollback) is downloaded",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.5", "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "download"
    },
    {
      "name": "a bridge level above the shell's: nothing",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 1 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 2 },
      "expect": "nothing"
    },
    {
      "name": "a bridge level below the shell's is downloaded",
      "shell": { "builtinVersion": "1.2.0", "bridgeLevel": 3 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "1.2.3", "bridgeLevel": 2 },
      "expect": "download"
    },
    {
      "name": "at or below the built-in release, drop wins over a bridge level above the shell's",
      "shell": { "builtinVersion": "1.2.3", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.4", "pending": null, "bad": [] },
      "payload": { "version": "1.2.2", "bridgeLevel": 2 },
      "expect": "drop"
    },
    {
      "name": "at or below the built-in release, drop wins over a release marked bad",
      "shell": { "builtinVersion": "1.2.3", "bridgeLevel": 1 },
      "bundles": { "active": "1.2.4", "pending": null, "bad": ["1.2.3"] },
      "payload": { "version": "1.2.3", "bridgeLevel": 1 },
      "expect": "drop"
    },
    {
      "name": "versions compare by number, not as text: 1.10.0 is above 1.9.0",
      "shell": { "builtinVersion": "1.9.0", "bridgeLevel": 1 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "1.10.0", "bridgeLevel": 1 },
      "expect": "download"
    },
    {
      "name": "versions compare by number, not as text: 1.9.0 is below 1.10.0",
      "shell": { "builtinVersion": "1.10.0", "bridgeLevel": 1 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "1.9.0", "bridgeLevel": 1 },
      "expect": "drop"
    },
    {
      "name": "the major version decides first",
      "shell": { "builtinVersion": "1.99.99", "bridgeLevel": 1 },
      "bundles": { "active": null, "pending": null, "bad": [] },
      "payload": { "version": "2.0.0", "bridgeLevel": 1 },
      "expect": "download"
    }
  ]
}
