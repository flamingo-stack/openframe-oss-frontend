# Editor defaults matching the files already in the repository:
# two-space TypeScript/JSON/YAML, four-space Java and Swift, LF endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{java,kt,swift}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
