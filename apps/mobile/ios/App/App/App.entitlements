<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Driven by the per-configuration APS_ENVIRONMENT build setting: `development`
	     in Debug*, `production` in Release*. Xcode's export step usually rewrites
	     a hardcoded value, but push is too load-bearing to leave implicit — verify
	     the archive with:
	       codesign -d --entitlements - <archive>/Products/Applications/App.app -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Native Sign in with Apple (ASAuthorizationController in NativeAuthPlugin).
	     Device builds need the capability enabled on the App ID (paid team); the
	     Simulator works without provisioning. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
